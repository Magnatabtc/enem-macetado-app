# Enem Macetado — variáveis de ambiente
#
# Copie para .env e ajuste:  cp .env.example .env
# O docker compose lê .env sozinho. Sem .env, os defaults do compose valem.
# NUNCA commite .env com segredos reais.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=enem
# Segredo de desenvolvimento. TROCAR EM PRODUÇÃO.
POSTGRES_PASSWORD=enem_dev_password
POSTGRES_DB=enem

# String de conexão usada pela API.
# Deixe comentada para o compose derivar automaticamente dos POSTGRES_* acima.
# Descomente e ajuste apenas se a senha tiver caracteres especiais (@ : / ?)
# ou se o banco for externo.
# DATABASE_URL=postgres://enem:enem_dev_password@db:5432/enem?sslmode=disable

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Segredo de assinatura dos JWT (HS256). TROCAR EM PRODUÇÃO por uma string
# longa e aleatória, ex.: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-in-production

PORT=8080
APP_TIMEZONE=America/Sao_Paulo

# Origens liberadas no CORS, separadas por vírgula (sem espaços).
# Inclui o Vite (dev) e o Nginx do compose.
CORS_ORIGINS=http://localhost:5173,http://localhost:8099

# ---------------------------------------------------------------------------
# Tutor com IA (opcional)
# ---------------------------------------------------------------------------
# Vazio = tutor local determinístico (funciona offline, sem custo).
# Com chave = chat completions em streaming no provedor abaixo.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TUTOR_MODEL=gpt-4o-mini

# Reconhecimento de fala (Whisper) e síntese de voz no servidor.
# false = o frontend usa Web Speech API / speechSynthesis do navegador.
STT_ENABLED=false
TTS_ENABLED=false
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# ---------------------------------------------------------------------------
# Conteúdo
# ---------------------------------------------------------------------------
# Dentro do container da API (arquivo presente na imagem).
# Em dev fora do Docker: ../content/questions.json
SEED_QUESTIONS_PATH=/app/content/questions.json
